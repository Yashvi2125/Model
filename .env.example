# MileMates AI Environment Configuration
# Copy this file to ".env" and add your API keys.

# ---- AI (Required for chat AI, conflict suggestions, and itineraries) -----------------
# Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite
WEATHERAPI_KEY=your_weatherapi_key_here

# ---- Telegram Bot & Multi-Platform Integration ----------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=Tripmate_planner_bot
# polling for local dev, webhook for production deployment
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=your_secret_random_webhook_string
# backend public URL (webhook receiver)
TELEGRAM_WEBHOOK_URL=https://tripmate-backend.onrender.com
# frontend web app URL (used in bot buttons & links)
PUBLIC_BASE_URL=http://localhost:3000
TELEGRAPH_ACCESS_TOKEN=
RELAY_WEB_TO_TELEGRAM=true

# ---- Live Web Research (Optional) ---------------------------------------------------
# Tavily API key from https://tavily.com/ (Itineraries still work without it)
TAVILY_API_KEY=your_tavily_api_key_here

# ---- Agent Settings -----------------------------------------------------------------
MAX_TURN=7
MAX_TURN_10=10
TERMINATION_WORD=stop

# ---- Local LLM (Ollama) Settings -----------------------------------------------------
# "gemini" | "qwen"
LLM_PROVIDER=gemini
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
# "qwen2.5:3b-instruct" | "qwen2.5:1.5b-instruct"
LOCAL_LLM_MODEL=qwen2.5:3b-instruct
LOCAL_LLM_TIMEOUT=60
# optional for OpenAI-compatible endpoints (Groq, OpenRouter, vLLM)
LOCAL_LLM_API_KEY=

# ---- Database Settings --------------------------------------------------------------
# Default: SQLite (no PostgreSQL or Docker required - works automatically on any machine)
DATABASE_URL=sqlite:///./tripmate_dev.db

# If using Docker Compose (PostgreSQL local):
POSTGRES_USER=tripmate
POSTGRES_PASSWORD=tripmate_password
POSTGRES_DB=tripmate

# If deploying to Supabase PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# ---- Web App Security ---------------------------------------------------------------
SECRET_KEY=dev-secret-key-replace-with-random-string-in-production
# development | production
APP_ENV=development
# set to true in production over HTTPS
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AI_AUTO_EXTRACT=true
